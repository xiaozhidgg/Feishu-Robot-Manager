# ===== 飞书自建应用凭证（开放平台 → 凭证与基础信息）=====
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== DeepSeek =====
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== 机器人人设（可自定义）=====
BOT_NAME=DeepSeek
SYSTEM_PROMPT=你是九叶化妆品有限公司内部的智能助手，回答简洁、准确，用中文作答。涉及公司业务时优先给出可执行建议。

# 每个会话保留最近 N 轮问答作为上下文（0 = 不保留上下文）
MAX_HISTORY_TURNS=6

# ===== 联网搜索（可选）=====
# on 开启，off 关闭。需要 DEEPSEEK_API_KEY，搜索与网页抓取都由 DeepSeek 官方接口完成。
WEB_SEARCH=off
# 每次返回几条搜索结果（1~5）
WEB_SEARCH_MAX_RESULTS=3
